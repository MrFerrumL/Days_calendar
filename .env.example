# 1. Создайте бота в @BotFather командой /newbot.
BOT_TOKEN=
# 2. Можно сначала оставить пустым, запустить бота и отправить ему /id.
# Затем запишите полученное число сюда и перезапустите бота.
OWNER_ID=
TIMEZONE=Europe/Moscow
# Необязательно: абсолютный путь к базе. По умолчанию ./runtime
# DATA_DIR=/app/runtime
# Стабильный адрес Mini App (для своего домена; локальный туннель настраивается автоматически).
# MINI_APP_URL=https://calendar.example.com
# MINI_APP_PORT=8765
# Необязательно: важные письма в чат. Для Gmail нужен пароль приложения
# (двухэтапная проверка → myaccount.google.com/apppasswords), а не обычный пароль.
# MAIL_USER=адрес@gmail.com
# MAIL_PASSWORD=abcd efgh ijkl mnop
# MAIL_IMAP_HOST=imap.gmail.com

# Необязательно: отдельный SOCKS5-канал только для Telegram (DNS через него).
# TELEGRAM_PROXY_URL=socks5h://172.18.0.1:9050
