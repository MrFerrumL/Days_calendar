# 1. Создайте бота в @BotFather командой /newbot.
BOT_TOKEN=
# 2. Можно сначала оставить пустым, запустить бота и отправить ему /id.
# Затем запишите полученное число сюда и перезапустите бота.
OWNER_ID=
TIMEZONE=Europe/Moscow
# Необязательно: абсолютный путь к базе. По умолчанию ./runtime
# DATA_DIR=/app/runtime
# Стабильный адрес Mini App (для своего домена; локальный туннель настраивается автоматически).
# MINI_APP_URL=https://calendar.example.com
# MINI_APP_PORT=8765
